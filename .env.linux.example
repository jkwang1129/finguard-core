# Copy to .env.linux on the authorized Linux host and run chmod 600.
# The zero SHA is syntax-valid for local configuration checks but is not deployable.
FINGUARD_APP_IMAGE=ghcr.io/jkwang1129/finguard-core:0000000000000000000000000000000000000000
FINGUARD_APP_PORT=8080
FINGUARD_APP_MEMORY_LIMIT=768m
FINGUARD_PROJECT_NAME=finguard
FINGUARD_DEPLOY_WAIT_TIMEOUT=180

MYSQL_ROOT_PASSWORD=replace-with-strong-random-root-password
MYSQL_DATABASE=finguard
MYSQL_USER=finguard
MYSQL_PASSWORD=replace-with-strong-random-app-password

RABBITMQ_USERNAME=finguard
RABBITMQ_PASSWORD=replace-with-strong-random-rabbit-password
RABBITMQ_VIRTUAL_HOST=/

REDIS_PASSWORD=replace-with-strong-random-redis-password

JWT_SECRET_BASE64=replace-with-base64-encoded-random-32-byte-secret

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-random-grafana-password

FINGUARD_REDIS_CONNECT_TIMEOUT=1s
FINGUARD_REDIS_COMMAND_TIMEOUT=1s
FINGUARD_STATISTICS_CACHE_TTL=60s
FINGUARD_RATE_LIMIT_LOGIN_LIMIT=5
FINGUARD_RATE_LIMIT_LOGIN_WINDOW=300s
FINGUARD_RATE_LIMIT_UPLOAD_LIMIT=10
FINGUARD_RATE_LIMIT_UPLOAD_WINDOW=60s

FINGUARD_IMPORT_CONSUMER_ENABLED=true
FINGUARD_IMPORT_CONSUMER_CONCURRENCY=1
FINGUARD_IMPORT_CONSUMER_PREFETCH=1
FINGUARD_RECONCILIATION_CONSUMER_ENABLED=true
FINGUARD_RECONCILIATION_CONSUMER_CONCURRENCY=1
FINGUARD_RECONCILIATION_CONSUMER_PREFETCH=1
FINGUARD_CONSUMER_FORWARD_CONFIRM_TIMEOUT=5s
FINGUARD_OUTBOX_ENABLED=true
FINGUARD_OUTBOX_FIXED_DELAY_MS=1000
FINGUARD_OUTBOX_BATCH_SIZE=50
FINGUARD_OUTBOX_CONFIRM_TIMEOUT=5s

FINGUARD_RISK_LARGE_AMOUNT_ENABLED=true
FINGUARD_RISK_LARGE_AMOUNT_THRESHOLD=10000.00
FINGUARD_RISK_POSSIBLE_DUPLICATE_ENABLED=true
FINGUARD_RISK_POSSIBLE_DUPLICATE_WINDOW=5m
FINGUARD_RISK_FREQUENT_TRANSACTION_ENABLED=true
FINGUARD_RISK_FREQUENT_TRANSACTION_WINDOW=10m
FINGUARD_RISK_FREQUENT_TRANSACTION_THRESHOLD_COUNT=5

# Enable only for the first deployment, then set false and recreate app.
FINGUARD_AUTH_BOOTSTRAP_ENABLED=false
FINGUARD_AUTH_BOOTSTRAP_ADMIN_USERNAME=
FINGUARD_AUTH_BOOTSTRAP_ADMIN_PASSWORD=
FINGUARD_AUTH_BOOTSTRAP_REVIEWER_USERNAME=
FINGUARD_AUTH_BOOTSTRAP_REVIEWER_PASSWORD=
