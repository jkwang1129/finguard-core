MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_DATABASE=finguard
MYSQL_USER=finguard
MYSQL_PASSWORD=replace-with-local-app-password
MYSQL_PORT=3306
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=finguard
RABBITMQ_PASSWORD=replace-with-local-rabbit-password
RABBITMQ_VIRTUAL_HOST=/
FINGUARD_IMPORT_CONSUMER_ENABLED=true
FINGUARD_IMPORT_CONSUMER_CONCURRENCY=1
FINGUARD_IMPORT_CONSUMER_PREFETCH=1
FINGUARD_OUTBOX_ENABLED=true
FINGUARD_OUTBOX_FIXED_DELAY_MS=1000
FINGUARD_OUTBOX_BATCH_SIZE=50
FINGUARD_OUTBOX_CONFIRM_TIMEOUT=5s
